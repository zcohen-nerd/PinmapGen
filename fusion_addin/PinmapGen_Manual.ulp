#usage "PinmapGen ULP - Generate firmware pinmaps from Fusion Electronics (manual netlist export)"

// ── Path discovery ─────────────────────────────────────────────────────────
// Paths are derived from where this ULP lives or loaded from a settings file
// saved next to it. Nothing is hardcoded to a specific machine.

string ulpDir = filedir(argv[0]);
string settingsFile = ulpDir + "PinmapGen_manual_settings.txt";

string mcuRef = "U1";
string outputDir = ulpDir + "PinmapGen_Output";
string mcuType = "rp2040";
string repoDir = "";   // Path to the cloned PinmapGen repository (required)
int generateMicroPython = 1;
int generateArduino = 1;
int generateMarkdown = 1;
int generateMermaid = 1;

// MCU profiles bundled with PinmapGen (see tools/pinmapgen/profiles/)
string validMcuList = "rp2040 rp2350 esp32 esp32s3 esp32c3 stm32g0 stm32f411 stm32h743 nrf52840 atmega328p atmega2560 atsamd21 atsamd51";

int isValidMcu(string candidate) {
    string parts[];
    int n = strsplit(parts, validMcuList, ' ');
    for (int i = 0; i < n; i++) {
        if (parts[i] == candidate) return 1;
    }
    return 0;
}

string trimCr(string s) {
    int len = strlen(s);
    if (len > 0 && s[len - 1] == '\r') {
        return strsub(s, 0, len - 1);
    }
    return s;
}

// Escape a value for embedding inside a PowerShell single-quoted string
// (single quotes are doubled). Prevents apostrophes in paths from
// breaking the generated command.
string psEscape(string s) {
    string result = "";
    for (int i = 0; i < strlen(s); i++) {
        if (s[i] == '\'') result += "''";
        else result += strsub(s, i, 1);
    }
    return result;
}

// Convert an EAGLE-style forward-slash path to backslashes for cmd.exe,
// which rejects forward-slash separators.
string toWindowsPath(string path) {
    string parts[];
    strsplit(parts, path, '/');
    return strjoin(parts, '\\');
}

// Read the CLI's --log-file back in; returns "" when the file is missing
// (which means Python never started).
string readLogFile(string path) {
    string found[];
    if (fileglob(found, path) == 0) return "";
    string content = "";
    if (fileread(content, path) <= 0) return "";
    return content;
}

// The CLI prefixes every problem line with one of these markers; any hit
// means the run deserves review even though files were written.
int logHasIssues(string logText) {
    if (strstr(logText, "Warning:") >= 0) return 1;
    if (strstr(logText, "Validation error:") >= 0) return 1;
    if (strstr(logText, "Error:") >= 0) return 1;
    return 0;
}

// Show a run's outcome with the full CLI log in a scrollable view -
// dlgMessageBox cannot scroll long output.
void showRunLog(string title, string message, string logText) {
    int r = dlgDialog(title) {
        dlgVBoxLayout {
            dlgLabel(message);
            dlgSpacing(5);
            dlgTextView(logText);
            dlgSpacing(5);
            dlgHBoxLayout {
                dlgStretch(1);
                dlgPushButton("+OK") dlgAccept();
            }
        }
    };
}

// Reference designators are passed to the CLI unquoted, so restrict them
// to safe characters (letters, digits, underscore, hyphen).
int isSafeRefDes(string s) {
    if (strlen(s) == 0) return 0;
    for (int i = 0; i < strlen(s); i++) {
        char c = s[i];
        int ok = (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
                 (c >= '0' && c <= '9') || c == '_' || c == '-';
        if (!ok) return 0;
    }
    return 1;
}

void loadSettings() {
    string found[];
    if (fileglob(found, settingsFile) == 0) return;

    string content;
    if (fileread(content, settingsFile) <= 0) return;

    string lines[];
    int n = strsplit(lines, content, '\n');
    for (int i = 0; i < n; i++) {
        string line = trimCr(lines[i]);
        int eq = strchr(line, '=');
        if (eq <= 0) continue;
        string key = strsub(line, 0, eq);
        string val = strsub(line, eq + 1);
        if (key == "mcuRef") mcuRef = val;
        else if (key == "outputDir") outputDir = val;
        else if (key == "mcuType") mcuType = val;
        else if (key == "repoDir") repoDir = val;
    }
}

void saveSettings() {
    output(settingsFile) {
        printf("# PinmapGen manual ULP settings - saved automatically\n");
        printf("mcuRef=%s\n", mcuRef);
        printf("outputDir=%s\n", outputDir);
        printf("mcuType=%s\n", mcuType);
        printf("repoDir=%s\n", repoDir);
    }
}

// ── Main execution ─────────────────────────────────────────────────────────

loadSettings();

int result = dlgDialog("PinmapGen Configuration") {
    dlgVBoxLayout {
        dlgHBoxLayout {
            dlgLabel("PinmapGen repository:");
            dlgStringEdit(repoDir);
        }
        dlgLabel("(folder containing the cloned PinmapGen repo - saved for next time)");
        dlgSpacing(5);

        dlgHBoxLayout {
            dlgLabel("MCU Type:");
            dlgStringEdit(mcuType);
        }
        dlgHBoxLayout {
            dlgPushButton("RP2040")  { mcuType = "rp2040"; }
            dlgPushButton("RP2350")  { mcuType = "rp2350"; }
            dlgPushButton("ESP32")   { mcuType = "esp32"; }
            dlgPushButton("ESP32-S3") { mcuType = "esp32s3"; }
            dlgPushButton("ESP32-C3") { mcuType = "esp32c3"; }
        }
        dlgHBoxLayout {
            dlgPushButton("STM32G0")   { mcuType = "stm32g0"; }
            dlgPushButton("STM32F411") { mcuType = "stm32f411"; }
            dlgPushButton("STM32H743") { mcuType = "stm32h743"; }
            dlgPushButton("nRF52840")  { mcuType = "nrf52840"; }
        }
        dlgHBoxLayout {
            dlgPushButton("ATmega328P") { mcuType = "atmega328p"; }
            dlgPushButton("ATmega2560") { mcuType = "atmega2560"; }
            dlgPushButton("SAMD21")     { mcuType = "atsamd21"; }
            dlgPushButton("SAMD51")     { mcuType = "atsamd51"; }
        }
        dlgSpacing(5);

        dlgHBoxLayout {
            dlgLabel("MCU Reference:");
            dlgStringEdit(mcuRef);
        }
        dlgSpacing(5);

        dlgHBoxLayout {
            dlgLabel("Output Directory:");
            dlgStringEdit(outputDir);
        }
        dlgHBoxLayout {
            dlgPushButton("ULP Folder") {
                outputDir = ulpDir + "PinmapGen_Output";
            }
        }
        dlgSpacing(10);

        dlgLabel("Output Formats:");
        dlgSpacing(2);
        dlgHBoxLayout {
            dlgCheckBox("MicroPython", generateMicroPython);
            dlgCheckBox("Arduino", generateArduino);
        }
        dlgHBoxLayout {
            dlgCheckBox("Documentation", generateMarkdown);
            dlgCheckBox("Mermaid Diagrams", generateMermaid);
        }
        dlgSpacing(10);

        dlgLabel("Note: Place 'live_netlist.csv' in the output folder before running");
    }
    dlgHBoxLayout {
        dlgPushButton("-Cancel") dlgReject();
        dlgPushButton("+Generate") dlgAccept();
    }
};

if (result) {
    saveSettings();

    // Validate inputs before doing anything
    string validationErrors = "";
    if (!isSafeRefDes(mcuRef)) {
        validationErrors += "- MCU Reference must be non-empty and contain only letters, digits, '_' or '-'\n";
    }
    if (strlen(outputDir) == 0) {
        validationErrors += "- Output Directory cannot be empty\n";
    }
    if (!isValidMcu(mcuType)) {
        validationErrors += "- MCU Type must be one of: " + validMcuList + "\n";
    }
    if (strlen(repoDir) == 0) {
        validationErrors += "- PinmapGen repository path cannot be empty.\n" +
                            "  Clone https://github.com/zcohen-nerd/PinmapGen and enter the folder path.\n";
    } else {
        string cliCheck[];
        if (fileglob(cliCheck, repoDir + "/tools/pinmapgen/cli.py") == 0) {
            validationErrors += "- '" + repoDir + "' does not look like the PinmapGen repository\n" +
                                "  (tools/pinmapgen/cli.py not found there)\n";
        }
    }

    if (strlen(validationErrors) > 0) {
        dlgMessageBox("Please fix the following issues:\n\n" + validationErrors, "Input Validation Failed");
        exit(1);
    }

    // Create output directory. cmd.exe /c is required because mkdir is a
    // cmd built-in and 2>nul is cmd redirection syntax; backslashes
    // because cmd rejects forward-slash paths.
    system("cmd.exe /c mkdir \"" + toWindowsPath(outputDir) + "\" 2>nul");

    // Look for manually exported netlist file
    string netlistFile = outputDir + "/live_netlist.csv";

    // Check if user has already exported a netlist file
    string netlistFound[];
    int netlistExists = fileglob(netlistFound, netlistFile) > 0;

    if (netlistExists) {
        // Every run mirrors its console output into this log via the
        // CLI's --log-file option; the dialogs below display it.
        string logFile = outputDir + "/pinmapgen_log.txt";

        // Build the CLI command; -NoProfile keeps user profiles from
        // interfering, and the trailing 'exit $LASTEXITCODE' makes
        // powershell.exe report the CLI's exit code instead of its own.
        // The closing quote of -Command is added last.
        string pinmapCmd = "powershell -NoProfile -Command \"cd '" + psEscape(repoDir) + "'; python -m tools.pinmapgen.cli --csv '" + psEscape(netlistFile) + "' --mcu " + mcuType + " --mcu-ref " + mcuRef + " --out-root '" + psEscape(outputDir) + "' --log-file '" + psEscape(logFile) + "'";

        if (generateMermaid) {
            pinmapCmd += " --mermaid";
        }

        pinmapCmd += " --verbose; exit $LASTEXITCODE\"";

        // Remove any stale log from a previous run so a missing file
        // afterwards reliably means Python never started this time.
        system("cmd.exe /c del \"" + toWindowsPath(logFile) + "\" 2>nul");

        int cliResult = system(pinmapCmd);
        string logContent = readLogFile(logFile);

        if (cliResult == 0 && logContent != "" && !logHasIssues(logContent)) {
            // Clean run: no warnings, no errors, no dropped pins.
            string successMsg = "Success!\n\nMCU: " + mcuType + " (" + mcuRef + ")\n\nGenerated files:\n";
            successMsg += "- pinmaps/pinmap.json\n";
            successMsg += "- firmware/micropython/pinmap_micropython.py\n";
            successMsg += "- firmware/include/pinmap_arduino.h\n";
            successMsg += "- firmware/docs/PINOUT.md\n";
            if (generateMermaid) successMsg += "- firmware/docs/pinout.mmd\n";
            successMsg += "\nUsing: Your exported netlist\nLocation: " + outputDir + "\nRun log: " + logFile;

            // Clean up temp netlist
            system("del \"" + netlistFile + "\" 2>nul");

            dlgMessageBox(successMsg, "OK");
            system("explorer \"" + outputDir + "\"");
        } else if (cliResult == 0 && logContent != "") {
            // Files were generated, but the CLI reported warnings,
            // validation errors, or dropped pins - show them instead of
            // pretending the run was clean. The netlist is kept.
            showRunLog(
                "Pinmap Generated With Issues",
                "PinmapGen finished, but reported issues you should review\nbefore trusting the generated files.\n\nOutput: " + outputDir,
                logContent);
            system("explorer \"" + outputDir + "\"");
        } else if (logContent != "") {
            // The CLI ran and failed - the log has the real reason.
            showRunLog(
                "Pinmap Generation Failed",
                "The PinmapGen CLI reported an error. The log below shows\nthe reason. Your netlist was kept:\n" + netlistFile,
                logContent);
            system("explorer \"" + outputDir + "\"");
        } else {
            // No log file was written: Python never started, so the
            // failure happened before the CLI could run.
            string errorMsg = "The PinmapGen CLI did not start (no log file was created).\n\n";
            errorMsg += "Most likely causes:\n";
            errorMsg += "- Python is not installed or not on PATH\n";
            errorMsg += "  (install Python 3.11+ and tick 'Add python.exe to PATH')\n";
            errorMsg += "- The PinmapGen repository path is wrong:\n  " + repoDir + "\n";
            errorMsg += "- The repository copy is older than this ULP\n";
            errorMsg += "  (it must support the --log-file option - update both together)\n\n";
            errorMsg += "Expected log location:\n" + logFile;

            dlgMessageBox(errorMsg, "OK");
        }
    } else {
        dlgMessageBox("No netlist found!\n\n" +
                      "This ULP expects a manually exported netlist.\n\n" +
                      "MANUAL EXPORT STEPS:\n" +
                      "1. In Fusion Electronics workspace\n" +
                      "2. Go to File -> Export -> Netlist\n" +
                      "3. Save as CSV to: " + outputDir + "\n" +
                      "4. Rename the file to 'live_netlist.csv'\n" +
                      "5. Run this ULP again\n\n" +
                      "Tip: PinmapGen.ulp (the main ULP) can generate the\n" +
                      "netlist automatically from the open schematic.",
                      "Netlist Not Found");
    }
}
